<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head' ) %>
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <div class="max-w-2xl mx-auto bg-white shadow-md rounded-lg mt-10 p-6">
      <h2 class="text-2xl font-bold mb-6 text-center text-blue-600">
        Add a New Home
      </h2>

      <form
        action="/host/add-home"
        method="POST"
        class="space-y-6"
        enctype="multipart/form-data"
        autocomplete="on"
      >
        <!-- Title -->
        <div>
          <label for="title" class="block text-sm font-medium text-gray-700"
            >Title</label
          >
          <input
            type="text"
            id="title"
            name="title"
            required
            autocomplete="on"
            class="mt-1 block w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <!-- Price -->
        <div>
          <label for="price" class="block text-sm font-medium text-gray-700"
            >Price</label
          >
          <input
            type="number"
            id="price"
            name="price"
            required
            autocomplete="on"
            class="mt-1 block w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <!-- Description -->
        <div>
          <label
            for="description"
            class="block text-sm font-medium text-gray-700"
            >Description</label
          >
          <textarea
            id="description"
            name="description"
            rows="4"
            required
            autocomplete="on"
            class="mt-1 block w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          ></textarea>
        </div>

        <!-- Location -->
        <div>
          <label for="location" class="block text-sm font-medium text-gray-700"
            >Location</label
          >
          <input
            type="text"
            id="location"
            name="location"
            required
            autocomplete="on"
            class="mt-1 block w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <!-- Image Upload -->
        <div>
          <label for="image" class="block text-sm font-medium text-gray-700">
            Image Upload
          </label>
          <input
            type="file"
            id="image"
            name="image"
            multiple
            required
            autocomplete="on"
            class="mt-1 block w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white"
          />
        </div>
        <!-- Rules PDF Upload -->
        <div>
          <label for="rulesPdf" class="block text-sm font-medium text-gray-700">
            Home Rules PDF
          </label>
          <input
            type="file"
            id="rulesPdf"
            name="rulesPdf"
            accept="application/pdf"
            autocomplete="on"
            class="mt-1 block w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white"
          />
        </div>

        <!-- Submit Button -->
        <div class="text-center">
          <button
            type="submit"
            class="bg-blue-600 text-white px-6 py-2 cursor-pointer rounded-md hover:bg-blue-700 transition"
          >
            Add Home
          </button>
        </div>
      </form>
    </div>
  </body>
</html>
