<nav class="bg-white shadow-md fixed top-0 w-full z-30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <!-- Logo -->
      <div class="flex items-center">
        <a href="/" class="text-xl font-bold text-blue-600">🏠 Home</a>
      </div>

      <!-- Desktop Menu -->
      <div class="hidden md:flex space-x-4 items-center">
        <% if (isLoggedIn) { %> <% if (user && user.userType === 'guest') { %>
        <a href="/home" class="text-gray-700 hover:text-blue-500 transition"
          >Home</a
        >
        <a href="/bookings" class="text-gray-700 hover:text-blue-500 transition"
          >Booking</a
        >
        <a
          href="/favourites"
          class="text-gray-700 hover:text-blue-500 transition"
          >Favourites</a
        >
        <%- include('../partials/logout.ejs') %> <% } else if (user &&
        user.userType === 'host') { %>
        <a
          href="/host/home"
          class="text-gray-700 hover:text-blue-500 transition"
          >Host Home</a
        >
        <a
          href="/host/add-home"
          class="text-gray-700 hover:text-blue-500 transition"
          >Add Home</a
        >
        <%- include('../partials/logout.ejs') %> <% } %> <% } else { %> <%-
        include('../partials/signup.ejs') %> <%-
        include('../partials/login.ejs') %> <% } %>
      </div>

      <!-- Mobile Menu Button -->
      <div class="md:hidden flex items-center">
        <button id="menu-btn" class="text-gray-700 focus:outline-none">
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="md:hidden hidden px-4 pb-4">
    <% if (isLoggedIn) { %> <% if (user && user.userType === 'guest') { %>
    <a href="/home" class="block py-2 text-gray-700 hover:text-blue-500"
      >Home</a
    >
    <a href="/bookings" class="block py-2 text-gray-700 hover:text-blue-500"
      >Booking</a
    >
    <a href="/favourites" class="block py-2 text-gray-700 hover:text-blue-500"
      >Favourites</a
    >
    <%- include('../partials/logout.ejs') %> <% } else if (user && user.userType
    === 'host') { %>
    <a href="/host/home" class="block py-2 text-gray-700 hover:text-blue-500"
      >Host Home</a
    >
    <a
      href="/host/add-home"
      class="block py-2 text-gray-700 hover:text-blue-500"
      >Add Home</a
    >
    <%- include('../partials/logout.ejs') %> <% } %> <% } else { %> <%-
    include('../partials/signup.ejs') %> <%- include('../partials/login.ejs') %>
    <% } %>
  </div>

  <script>
    const menuBtn = document.getElementById("menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    menuBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("hidden");
    });
  </script>
</nav>
