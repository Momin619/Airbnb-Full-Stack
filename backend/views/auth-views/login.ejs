<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head' ) %>
  </head>
  <body class="bg-gradient-to-br from-blue-100 to-blue-300 min-h-screen">
    <%- include('../partials/navbar.ejs') %>
    <div class="max-w-2xl mx-auto bg-white shadow-xl rounded-2xl p-8 my-24">
      <div class="mb-8 text-center">
        <img
          src="https://cdn-icons-png.flaticon.com/512/747/747376.png"
          alt="User Icon"
          class="mx-auto w-20 h-20 mb-4 rounded-full shadow-md"
        />
        <h2 class="font-extrabold text-blue-700 text-4xl mb-2">
          Welcome Back!
        </h2>
        <p class="text-gray-500">Please login to your account to continue</p>
      </div>
      <%- include('../partials/error.ejs') %>
      <form action="/login" method="POST" class="space-y-6">
        <!-- Email -->
        <div>
          <label
            for="email"
            class="block text-sm font-medium text-gray-700 mb-1"
            >Email</label
          >
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3">
              <!-- Heroicon: Envelope -->
              <svg
                class="h-5 w-5 text-blue-400"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16 12l-4-4-4 4m8 0v6a2 2 0 01-2 2H6a2 2 0 01-2-2v-6m16-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v4"
                ></path>
              </svg>
            </span>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="Enter your Email..."
              value="<%= oldInput ? oldInput.email : '' %>"
              class="pl-10 mt-1 block w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
        </div>
        <!-- Password -->
        <div>
          <label
            for="password"
            class="block text-sm font-medium text-gray-700 mb-1"
            >Password</label
          >
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3">
              <!-- Heroicon: Lock Closed -->
              <svg
                class="h-5 w-5 text-blue-400"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 15v2m6-6V9a6 6 0 10-12 0v2m12 0a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2v-6a2 2 0 012-2h12z"
                ></path>
              </svg>
            </span>
            <input
              type="password"
              id="password"
              name="password"
              required
              placeholder="Enter your Password..."
              class="pl-10 mt-1 block w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
          <div class="text-right mt-1">
            <a
              href="/forgot-password"
              class="text-blue-500 text-sm hover:underline"
              >Forgot Password?</a
            >
          </div>
        </div>
        <!-- Submit Button -->
        <div class="text-center">
          <button
            type="submit"
            class="bg-blue-600 cursor-pointer text-white px-8 py-2 font-semibold rounded-md hover:bg-blue-700 transition shadow-lg"
          >
            <span class="inline-flex items-center">
              <!-- Heroicon: Login -->
              <svg
                class="h-5 w-5 mr-2"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 12H3m0 0l4-4m-4 4l4 4m13-4a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
              Login
            </span>
          </button>
        </div>
        <div class="text-center mt-4">
          <span class="text-gray-600">Don't have an account?</span>
          <a
            href="/signup"
            class="inline-flex items-center text-blue-600 font-semibold hover:underline ml-1"
          >
            Sign Up
          </a>
        </div>
      </form>
    </div>
  </body>
</html>
