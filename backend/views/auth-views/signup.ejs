<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head.ejs') %>
  <body class="bg-gradient-to-br from-blue-100 to-blue-300 min-h-screen flex items-center justify-center p-4">
    <%- include('../partials/navbar.ejs') %>
    <div class="bg-white shadow-xl rounded-2xl w-full max-w-md p-8 space-y-6 my-20">
      <div class="mb-6 text-center">
        <img src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png" alt="Sign Up Icon" class="mx-auto w-20 h-20 mb-4 rounded-full shadow-md">
        <h2 class="font-extrabold text-blue-700 text-4xl mb-2">Create an Account</h2>
        <p class="text-gray-500">Join us and start your journey!</p>
      </div>

      <form action="/signup" method="POST" class="space-y-4">
        <%- include('../partials/error.ejs') %>

        <!-- First & Last Name -->
        <div class="flex flex-col sm:flex-row gap-4">
          <div class="flex-1">
            <label for="firstName" class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                <!-- Heroicon: User -->
                <svg class="h-5 w-5 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A9 9 0 1112 21a9 9 0 01-6.879-3.196z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </span>
              <input
                type="text"
                id="firstName"
                name="firstName"
                value="<%= oldInput ? oldInput.firstName : '' %>"
                placeholder="Enter first name..."
                class="pl-10 w-full mt-1 px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
            </div>
          </div>
          <div class="flex-1">
            <label for="lastName" class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                <!-- Heroicon: User -->
                <svg class="h-5 w-5 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A9 9 0 1112 21a9 9 0 01-6.879-3.196z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </span>
              <input
                type="text"
                id="lastName"
                name="lastName"
                value="<%= oldInput ? oldInput.lastName : '' %>"
                placeholder="Enter last name..."
                class="pl-10 w-full mt-1 px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
            </div>
          </div>
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3">
              <!-- Heroicon: Envelope -->
              <svg class="h-5 w-5 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 12l-4-4-4 4m8 0v6a2 2 0 01-2 2H6a2 2 0 01-2-2v-6m16-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v4"></path>
              </svg>
            </span>
            <input
              type="email"
              id="email"
              name="email"
              value="<%= oldInput ? oldInput.email : '' %>"
              placeholder="Enter your email..."
              class="pl-10 w-full mt-1 px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
        </div>

        <!-- Password -->
        <div>
          <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3">
              <!-- Heroicon: Lock Closed -->
              <svg class="h-5 w-5 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m6-6V9a6 6 0 10-12 0v2m12 0a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2v-6a2 2 0 012-2h12z"/>
              </svg>
            </span>
            <input
              placeholder="Enter your password"
              type="password"
              id="password"
              name="password"
              required
              class="pl-10 w-full mt-1 px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              value="<%= oldInput ? oldInput.password : '' %>"
            />
          </div>
        </div>

        <!-- Confirm Password -->
        <div>
          <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-1">Confirm Password</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3">
              <!-- Heroicon: Check -->
              <svg class="h-5 w-5 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            <input
              placeholder="Re-enter your password"
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              required
              class="pl-10 w-full mt-1 px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
        </div>

        <!-- User Type -->
        <div>
          <label for="userType" class="block text-sm font-medium text-gray-700 mb-1">User Type</label>
          <select
            id="userType"
            name="userType"
            class="w-full mt-1 px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="guest" <%= oldInput && oldInput.userType === 'guest' ? 'selected' : '' %>>Guest</option>
            <option value="host" <%= oldInput && oldInput.userType === 'host' ? 'selected' : '' %>>Host</option>
          </select>
        </div>

        <!-- Terms & Conditions -->
        <div class="flex items-center">
          <input
            id="terms"
            name="terms"
            type="checkbox"
            required
            class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
          />
          <label for="terms" class="ml-2 block text-sm text-gray-600">
            I agree to the
            <a href="#" class="text-blue-600 underline">Terms and Conditions</a>
          </label>
        </div>

        <!-- Submit Button -->
        <div class="text-center">
          <button
            type="submit"
            class="bg-blue-600 cursor-pointer text-white px-8 py-2 font-semibold rounded-md hover:bg-blue-700 transition shadow-lg"
          >
            <span class="inline-flex items-center">
              <!-- Heroicon: User Add -->
              <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v6m3-3h-6m-2 4a4 4 0 100-8 4 4 0 000 8zm6 4a6 6 0 10-12 0v2a2 2 0 002 2h8a2 2 0 002-2v-2z"/>
              </svg>
              Sign Up
            </span>
          </button>
        </div>

        <!-- Divider -->
        <div class="flex items-center my-6">
          <div class="flex-grow border-t border-gray-300"></div>
          <span class="mx-4 text-gray-400 font-semibold">OR</span>
          <div class="flex-grow border-t border-gray-300"></div>
        </div>

        <!-- Social Signup -->
        <div class="flex flex-col gap-3">
          <button type="button" class="flex items-center justify-center w-full px-4 py-2 border border-gray-300 rounded-md bg-white hover:bg-gray-100 transition">
            <!-- Google Icon -->
            <svg class="h-5 w-5 mr-2" viewBox="0 0 48 48">
              <g>
                <path fill="#4285F4" d="M44.5 20H24v8.5h11.7C34.7 33.4 29.8 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.1 8.1 2.9l6.1-6.1C34.5 6.5 29.5 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20c11 0 19.7-8 19.7-20 0-1.3-.1-2.7-.2-4z"/>
                <path fill="#34A853" d="M6.3 14.7l7 5.1C15.5 16.2 19.4 13 24 13c3.1 0 5.9 1.1 8.1 2.9l6.1-6.1C34.5 6.5 29.5 4 24 4c-7.7 0-14.3 4.3-17.7 10.7z"/>
                <path fill="#FBBC05" d="M24 44c5.5 0 10.5-1.8 14.4-4.9l-6.7-5.5C29.8 38 27 39 24 39c-5.7 0-10.5-3.6-12.2-8.5l-7 5.4C9.7 41.7 16.3 44 24 44z"/>
                <path fill="#EA4335" d="M44.5 20H24v8.5h11.7c-1.1 3.1-4.1 5.5-7.7 5.5-2.2 0-4.2-.7-5.7-2l-7 5.4C18.5 41.4 21.1 44 24 44c11 0 19.7-8 19.7-20 0-1.3-.1-2.7-.2-4z"/>
              </g>
            </svg>
            Sign up with Google
          </button>
          <button type="button" class="flex items-center justify-center w-full px-4 py-2 border border-gray-300 rounded-md bg-white hover:bg-gray-100 transition">
            <!-- Facebook Icon -->
            <svg class="h-5 w-5 mr-2" fill="#1877F3" viewBox="0 0 24 24">
              <path d="M22.675 0h-21.35C.595 0 0 .592 0 1.326v21.348C0 23.408.595 24 1.325 24h11.495v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.797.143v3.24l-1.918.001c-1.504 0-1.797.715-1.797 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116C23.406 24 24 23.408 24 22.674V1.326C24 .592 23.406 0 22.675 0"/>
            </svg>
            Sign up with Facebook
          </button>
        </div>

        <!-- Login Prompt -->
        <div class="text-center mt-6">
          <span class="text-gray-600">Already have an account?</span>
          <a href="/" class="inline-flex items-center text-blue-600 font-semibold hover:underline ml-1">
            <svg class="h-5 w-5 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12H3m0 0l4-4m-4 4l4 4m13-4a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Login
          </a>
        </div>