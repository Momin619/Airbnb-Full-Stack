<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head.ejs') %>
    <title><%= pageTitle %></title>
  </head>
  <body class="bg-gray-100">
    <%- include('../partials/navbar.ejs') %>

    <div class="container mx-auto px-4 py-8">
      <h1 class="text-3xl font-bold text-center mb-6">Your Favourite Homes</h1>

      <% if (favourites.length === 0) { %>
      <p class="text-center text-gray-600">You have no favourite homes yet.</p>
      <% } else { %>
      <div
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"
      >
        <% favourites.forEach(home => { %>
        <div class="bg-white shadow-lg rounded-lg overflow-hidden">
          <img
            src="<%= home.image %>"
            alt="<%= home.title %>"
            class="w-full h-48 object-cover"
          />
          <div class="p-4">
            <h2 class="text-xl font-semibold text-gray-800">
              <%= home.title %>
            </h2>
            <p class="text-gray-600"><%= home.location %></p>
            <p class="text-gray-700 mt-2"><%= home.description %></p>
            <p class="text-green-600 font-bold mt-2">$<%= home.price %></p>
            <form
              action="/remove-favourite/home/<%= home._id %>"
              method="post"
              class="mt-3"
            >
              <button
                type="submit"
                class="bg-red-500 cursor-pointer text-white px-4 py-2 rounded hover:bg-red-600"
              >
                Remove from favourites
              </button>
            </form>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </body>
</html>
